[Unit]
Description=Book Reader Outreach Web
After=network-online.target
Wants=network-online.target
[Service]
User=outreach
Group=outreach
WorkingDirectory=/opt/book-reader-outreach
Environment=OUTREACH_DATA_DIR=/var/lib/book-reader-outreach
Environment=OUTREACH_SECURE_COOKIE=false
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/book-reader-outreach/.venv/bin/python -m uvicorn outreach.web:create_app --factory --host 127.0.0.1 --port 8096 --no-access-log
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/book-reader-outreach
PrivateTmp=true
ProtectHome=true
[Install]
WantedBy=multi-user.target
